{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "selection.schema.json",
  "title": "selections/<type>.yaml",
  "description": "Facts and layout for one job type. Holds IDs only, never fact text.",
  "type": "object",
  "required": ["schema_version", "type", "tier", "headline", "section_order", "work",
               "projects", "education", "skills", "max_pages", "approval"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "type": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "tier": {"enum": [1, 2, 3]},
    "headline": {"type": "string", "minLength": 1},
    "summary_basis": {"type": "array", "items": {"type": "string"}},
    "section_order": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "prefixItems": [
          {"enum": ["personalInfo", "summary", "workExperience", "personalProjects",
                    "education", "additional"]},
          {"type": "string", "minLength": 1}
        ],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "work": {"type": "array", "items": {"$ref": "#/$defs/pick"}},
    "projects": {"type": "array", "items": {"$ref": "#/$defs/pick"}},
    "education": {"type": "array", "items": {"type": "string"}},
    "skills": {"type": "array", "items": {"type": "string"}},
    "max_pages": {"type": "integer", "minimum": 1},
    "approval": {
      "type": "object",
      "required": ["date", "content_hash"],
      "additionalProperties": false,
      "properties": {
        "date": {"type": ["string", "null"]},
        "content_hash": {"type": ["string", "null"]}
      }
    }
  },
  "$defs": {
    "pick": {
      "type": "object",
      "required": ["id", "bullets"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "bullets": {"type": "array", "items": {"type": "string"}},
        "condensed": {"type": "boolean"}
      }
    }
  }
}
